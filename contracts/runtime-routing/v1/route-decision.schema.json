{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://simplicio.dev/contracts/runtime-routing/v1/route-decision.schema.json",
  "title": "simplicio.route-decision/v1",
  "type": "object",
  "required": [
    "schema",
    "policy_version",
    "decision_id",
    "intent",
    "lane",
    "reason",
    "capability",
    "selected_handles",
    "max_skills",
    "max_bytes",
    "runtime_status",
    "authority",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "simplicio.route-decision/v1" },
    "policy_version": { "const": "simplicio-loop-route-policy/v1" },
    "decision_id": {
      "type": "string",
      "pattern": "^loop-route/[0-9a-f]{64}$"
    },
    "intent": {
      "enum": ["govern", "orchestrate", "validate", "mutate", "retrieve", "survey"]
    },
    "lane": { "enum": ["batch", "standard", "interactive"] },
    "reason": { "type": "string", "minLength": 1 },
    "capability": { "const": "prompt.enrich" },
    "selected_handles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "max_skills": { "type": "integer", "minimum": 1, "maximum": 64 },
    "max_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
    "runtime_status": { "enum": ["available", "unavailable", "incompatible"] },
    "authority": {
      "type": "object",
      "properties": {
        "writes": { "const": false },
        "effects": { "const": false }
      },
      "required": ["writes", "effects"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["producer", "policy_version", "source", "portable_route_id", "task_digest"],
      "properties": {
        "producer": { "const": "simplicio-loop" },
        "policy_version": { "const": "simplicio-loop-route-policy/v1" },
        "source": { "type": "string", "minLength": 1 },
        "portable_route_id": { "type": ["string", "null"] },
        "task_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_decision_id": { "type": "string", "minLength": 1 },
        "source_reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
