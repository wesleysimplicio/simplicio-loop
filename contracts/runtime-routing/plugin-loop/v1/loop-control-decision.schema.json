{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/runtime-routing/plugin-loop/v1/loop-control-decision.schema.json",
  "title": "LoopControlDecision",
  "type": "object",
  "required": ["schema", "action", "reason", "mode", "iteration", "goal_digest"],
  "properties": {
    "schema": { "const": "simplicio.loop-control-decision/v1" },
    "action": { "enum": ["continue", "replan", "pause", "stop", "refeed"] },
    "reason": { "type": "string" },
    "mode": { "enum": ["runtime-bound", "standalone"] },
    "iteration": { "type": "integer", "minimum": 0 },
    "goal_digest": { "type": "string" },
    "refeed_delta": { "type": "string" },
    "can_prove_external_effect": { "type": "boolean" },
    "completion_ready": { "type": "boolean" }
  },
  "additionalProperties": true
}
