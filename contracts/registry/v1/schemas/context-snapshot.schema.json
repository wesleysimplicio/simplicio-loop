{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/context-snapshot/v1/schema.json",
  "contract": "simplicio.context-snapshot/v1",
  "version": "1.0.0",
  "payload_required": ["snapshot_id", "source", "files"],
  "payload_schema": {
    "type": "object",
    "required": ["snapshot_id", "source", "files"],
    "properties": {
      "snapshot_id": {"type": "string", "minLength": 1},
      "source": {"type": "string", "minLength": 1},
      "files": {"type": "array", "items": {"type": "string"}},
      "metadata": {"type": "object"}
    },
    "additionalProperties": true
  }
}
