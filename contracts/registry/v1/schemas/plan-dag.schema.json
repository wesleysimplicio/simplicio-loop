{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/plan-dag/v1/schema.json",
  "contract": "simplicio.plan-dag/v1",
  "version": "1.0.0",
  "payload_required": ["plan_id", "nodes", "edges"],
  "payload_schema": {
    "type": "object",
    "required": ["plan_id", "nodes", "edges"],
    "properties": {
      "plan_id": {"type": "string", "minLength": 1},
      "nodes": {"type": "array", "items": {"type": "object"}},
      "edges": {"type": "array", "items": {"type": "object"}}
    },
    "additionalProperties": true
  }
}
