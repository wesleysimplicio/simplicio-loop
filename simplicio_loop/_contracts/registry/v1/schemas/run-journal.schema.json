{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/run-journal/v1/schema.json",
  "contract": "simplicio.run-journal/v1",
  "version": "1.0.0",
  "payload_required": ["run_id", "event", "entries"],
  "payload_schema": {
    "type": "object",
    "required": ["run_id", "event", "entries"],
    "properties": {
      "run_id": {"type": "string", "minLength": 1},
      "event": {"type": "string", "minLength": 1},
      "entries": {"type": "array", "items": {"type": "object"}}
    },
    "additionalProperties": true
  }
}
