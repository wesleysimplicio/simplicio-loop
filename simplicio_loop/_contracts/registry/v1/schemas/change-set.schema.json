{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/change-set/v1/schema.json",
  "contract": "simplicio.change-set/v1",
  "version": "1.0.0",
  "payload_required": ["base_hash", "files"],
  "payload_schema": {
    "type": "object",
    "required": ["base_hash", "files"],
    "properties": {
      "base_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "files": {"type": "array", "items": {"type": "object"}},
      "summary": {"type": "string"}
    },
    "additionalProperties": true
  }
}
