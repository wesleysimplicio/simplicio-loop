{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/fast-generation/v1/schema.json",
  "contract": "simplicio.fast-generation/v1",
  "version": "1.0.0",
  "payload_required": ["generation_id", "source_hash", "engine"],
  "payload_schema": {
    "type": "object",
    "required": ["generation_id", "source_hash", "engine"],
    "properties": {
      "generation_id": {"type": "string", "minLength": 1},
      "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "engine": {"type": "string", "enum": ["rust", "python"]},
      "capabilities": {"type": "array", "items": {"type": "string"}}
    },
    "additionalProperties": true
  }
}
