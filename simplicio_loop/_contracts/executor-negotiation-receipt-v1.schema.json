{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/executor-negotiation-receipt-v1.schema.json",
  "title": "ExecutorNegotiationReceipt/v1",
  "type": "object",
  "required": [
    "schema", "stage_id", "status", "reason_code", "dry_run",
    "required_capabilities", "selected", "skipped", "unavailable",
    "fallback", "doctor_handshake_sha", "model_provider_started",
    "execution_started", "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "simplicio.executor-negotiation-receipt/v1"},
    "stage_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["SELECTED", "BLOCKED"]},
    "reason_code": {"type": ["string", "null"]},
    "dry_run": {"type": "boolean"},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "selected": {"type": ["object", "null"]},
    "skipped": {"type": "array", "items": {"type": "object"}},
    "unavailable": {"type": "array", "items": {"type": "object"}},
    "fallback": {"type": "object"},
    "doctor_handshake_sha": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "model_provider_started": {"const": false},
    "execution_started": {"const": false},
    "receipt_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
