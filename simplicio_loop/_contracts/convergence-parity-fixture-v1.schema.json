{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/convergence-parity-fixture-v1.schema.json",
  "title": "ConvergenceParityFixture/v1",
  "type": "object",
  "required": [
    "schema",
    "fixture_id",
    "provenance",
    "task",
    "signals",
    "loop_evidence",
    "runtime_decision",
    "standalone_runtime"
  ],
  "properties": {
    "schema": {"const": "simplicio.convergence-parity-fixture/v1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": ["repository", "revision", "source"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": ["task_id", "title"],
      "properties": {
        "run_id": {"type": "string"},
        "task_id": {"type": "string", "minLength": 1},
        "issue": {"type": "string"},
        "title": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema", "signal_id", "source", "evidence", "semantic", "outcome"],
        "properties": {
          "schema": {"const": "simplicio.progress-signal/v1"},
          "signal_id": {"type": "string", "minLength": 1},
          "source": {"enum": ["agent", "loop"]},
          "evidence": {
            "type": "object",
            "required": ["id", "hash"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "hash": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "semantic": {"type": "object"},
          "strategy_hash": {"type": "string"},
          "outcome": {"type": "string"},
          "action": {"type": "string"},
          "wait": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "loop_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "acceptance_verified": {"type": "boolean"},
          "delivery_verified": {"type": "boolean"},
          "external_changed": {"type": "boolean"},
          "evidence_id": {"type": "string"},
          "evidence_hash": {"type": "string"},
          "semantic": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "runtime_decision": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["schema", "authority", "host_may_override", "use_loop", "task_fingerprint"],
          "properties": {
            "schema": {"type": "string"},
            "authority": {"type": "string"},
            "host_may_override": {"type": "boolean"},
            "use_loop": {"type": "boolean"},
            "task_fingerprint": {"type": "string"}
          },
          "additionalProperties": true
        }
      ]
    },
    "standalone_runtime": {
      "type": "object",
      "required": ["status", "reason_code", "effects_attempted"],
      "properties": {
        "status": {"enum": ["unavailable", "incompatible", "not_configured"]},
        "reason_code": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "effects_attempted": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "properties": {
        "loop_evidence": {
          "minItems": 1
        }
      }
    }
  ],
  "additionalProperties": false
}