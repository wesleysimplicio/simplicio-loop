{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/convergence-parity-v1.schema.json",
  "title": "ConvergenceParityReceipt/v1",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["repository", "revision", "source"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "executionReport": {
      "type": "object",
      "required": [
        "schema",
        "status",
        "execution_profile",
        "provenance",
        "tasks",
        "measured_fields",
        "unverified_fields",
        "unavailable_reasons"
      ],
      "properties": {
        "schema": {"const": "simplicio.execution-report/v1"},
        "status": {"enum": ["VERIFIED", "FAILED", "UNSUPPORTED"]},
        "execution_profile": {"enum": ["runtime-backed", "operator-standalone"]},
        "provenance": {"$ref": "#/$defs/provenance"},
        "tasks": {"type": "array", "minItems": 1},
        "measured_fields": {"type": "array", "items": {"type": "string"}},
        "unverified_fields": {"type": "array", "items": {"type": "string"}},
        "unavailable_reasons": {"type": "object"}
      },
      "additionalProperties": true
    },
    "pathReceipt": {
      "type": "object",
      "required": [
        "schema",
        "path",
        "status",
        "reason_code",
        "detail",
        "effects_attempted",
        "runtime_decision",
        "runtime_observation",
        "semantic_receipts",
        "acceptance_evidence",
        "execution_report"
      ],
      "properties": {
        "schema": {"const": "simplicio.convergence-path-receipt/v1"},
        "path": {"enum": ["runtime_backed", "standalone"]},
        "status": {"enum": ["VERIFIED", "FAILED", "UNSUPPORTED"]},
        "reason_code": {"type": ["string", "null"]},
        "detail": {"type": ["string", "null"]},
        "effects_attempted": {"const": false},
        "runtime_decision": {"type": ["object", "null"]},
        "runtime_observation": {"type": ["object", "null"]},
        "semantic_receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["schema", "state", "reason", "transition", "evidence_id", "evidence_hash"],
            "properties": {
              "schema": {"const": "simplicio.semantic-convergence/v1"},
              "state": {"type": "string"},
              "reason": {"type": "string"},
              "transition": {"type": "object"},
              "evidence_id": {"type": "string"},
              "evidence_hash": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "acceptance_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "signal_id",
              "evidence_id",
              "evidence_hash",
              "acceptance_verified",
              "delivery_verified"
            ],
            "properties": {
              "signal_id": {"type": "string"},
              "evidence_id": {"type": "string"},
              "evidence_hash": {"type": "string"},
              "acceptance_verified": {"type": "boolean"},
              "delivery_verified": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "execution_report": {"$ref": "#/$defs/executionReport"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "UNSUPPORTED"}}},
          "then": {
            "properties": {
              "reason_code": {"type": "string", "minLength": 1},
              "semantic_receipts": {"maxItems": 0},
              "acceptance_evidence": {"maxItems": 0}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "fixture_schema",
    "fixture_id",
    "provenance",
    "status",
    "parity",
    "comparison",
    "unsupported_environments",
    "runtime_backed",
    "standalone"
  ],
  "properties": {
    "schema": {"const": "simplicio.convergence-parity/v1"},
    "fixture_schema": {"const": "simplicio.convergence-parity-fixture/v1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "provenance": {"$ref": "#/$defs/provenance"},
    "status": {"enum": ["VERIFIED", "FAILED", "UNSUPPORTED"]},
    "parity": {"type": "boolean"},
    "comparison": {
      "type": "object",
      "required": ["semantic_receipts_equal", "acceptance_evidence_equal"],
      "properties": {
        "semantic_receipts_equal": {"type": ["boolean", "null"]},
        "acceptance_evidence_equal": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "unsupported_environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason_code", "detail"],
        "properties": {
          "path": {"enum": ["runtime_backed", "standalone"]},
          "reason_code": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "runtime_backed": {"$ref": "#/$defs/pathReceipt"},
    "standalone": {"$ref": "#/$defs/pathReceipt"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "VERIFIED"}}},
      "then": {
        "properties": {
          "parity": {"const": true},
          "unsupported_environments": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "UNSUPPORTED"}}},
      "then": {
        "properties": {
          "parity": {"const": false},
          "unsupported_environments": {"minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": false
}