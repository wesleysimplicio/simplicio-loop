{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/capability-lease-v1.schema.json",
  "title": "CapabilityLease/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "resource_key", "owner_id", "attempt", "fence",
    "issued_at", "heartbeat_at", "expires_at", "state"
  ],
  "properties": {
    "schema": {"const": "simplicio.capability-lease/v1"},
    "resource_key": {"type": "string", "minLength": 1},
    "owner_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "fence": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "number"},
    "heartbeat_at": {"type": "number"},
    "expires_at": {"type": "number"},
    "state": {"enum": ["active", "stale", "released"]}
  }
}
