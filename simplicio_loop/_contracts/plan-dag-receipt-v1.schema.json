{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/contracts/plan-dag-receipt-v1.schema.json",
  "title": "PlanDAGReceipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "event", "plan_id", "plan_revision", "plan_hash",
    "assignments", "logical_tasks_unchanged", "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "simplicio.plan-dag-receipt/v1"},
    "event": {"const": "slots_bound"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "plan_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "assignments": {"type": "object", "additionalProperties": {"type": "string"}},
    "logical_tasks_unchanged": {"const": true},
    "receipt_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
